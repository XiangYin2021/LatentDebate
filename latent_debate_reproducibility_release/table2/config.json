  },
  "layer_regions": [[0, 10], [10, 20], [20, 31]],
  "classifier": {
    "objective": "binary:logistic",
    "n_estimators": 100,
    "max_depth": 2,
    "learning_rate": 0.03,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 1,
    "reg_lambda": 1,
    "reg_alpha": 0,
    "eval_metric": "logloss",
    "tree_method": "hist",
    "device": "cpu",
    "n_jobs": 2
  },
  "summary_standard_deviation_ddof": 1,
  "code_only_rows": ["SelfCheckGPT", "Semantic Entropy"]
